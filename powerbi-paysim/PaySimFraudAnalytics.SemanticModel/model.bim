          },
          {
            "name": "total_amount",
            "dataType": "decimal",
            "formatString": "#,0.00",
            "lineageTag": "81626940-6f77-4ce4-ba8b-6b0aca228fb6",
            "sourceColumn": "total_amount",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "50d3ffb5-4136-40da-9bb5-e3a14b7c64aa",
        "measures": [
          {
            "name": "Transactions",
            "expression": "COALESCE(SUM(Activity[transaction_count]), 0)",
            "formatString": "#,0",
            "lineageTag": "8b9965f0-6cae-41b9-b63f-9697db85b5da"
          },
          {
            "name": "Transaction Amount",
            "expression": "COALESCE(SUM(Activity[total_amount]), 0)",
            "formatString": "#,0.00",
            "lineageTag": "fe00f6fd-8804-426e-a454-08928ad97f5b"
          },
          {
            "name": "Fraud Transactions",
            "expression": "CALCULATE([Transactions], KEEPFILTERS(Activity[is_fraud] = 1))",
            "formatString": "#,0",
            "lineageTag": "769a3cfb-bff3-442f-900e-ffe5e4fad8a6"
          },
          {
            "name": "Fraud Amount",
            "expression": "CALCULATE([Transaction Amount], KEEPFILTERS(Activity[is_fraud] = 1))",
            "formatString": "#,0.00",
            "lineageTag": "295e4d70-2f0c-44bf-ada9-8ead2d3d6d9b"
          },
          {
            "name": "Fraud Rate",
            "expression": "DIVIDE([Fraud Transactions], [Transactions])",
            "formatString": "0.0000%",
            "lineageTag": "d8f62bc2-46c7-4c55-bb59-26f9dd2f2ebf"
          },
          {
            "name": "Flagged Transactions",
            "expression": "CALCULATE([Transactions], KEEPFILTERS(Activity[is_flagged] = 1))",
            "formatString": "#,0",
            "lineageTag": "9c16e055-3207-4387-99be-d1f3472d03eb"
          },
          {
            "name": "True Positives",
            "expression": "CALCULATE([Transactions], KEEPFILTERS(Activity[is_fraud] = 1), KEEPFILTERS(Activity[is_flagged] = 1))",
            "formatString": "#,0",
            "lineageTag": "26347789-ad8b-4a2c-aa52-532625eece0f"
          },
          {
            "name": "False Positives",
            "expression": "CALCULATE([Transactions], KEEPFILTERS(Activity[is_fraud] = 0), KEEPFILTERS(Activity[is_flagged] = 1))",
            "formatString": "#,0",
            "lineageTag": "9c5aaa69-81bd-4477-94e5-eb11908570ca"
          },
          {
            "name": "False Negatives",
            "expression": "CALCULATE([Transactions], KEEPFILTERS(Activity[is_fraud] = 1), KEEPFILTERS(Activity[is_flagged] = 0))",
            "formatString": "#,0",
            "lineageTag": "084833c4-addc-4359-90f2-5e8380641a58"
          },
          {
            "name": "True Negatives",
            "expression": "CALCULATE([Transactions], KEEPFILTERS(Activity[is_fraud] = 0), KEEPFILTERS(Activity[is_flagged] = 0))",
            "formatString": "#,0",
            "lineageTag": "3d11e328-2c3a-444c-8024-f7a9c8013f7a"
          },
          {
            "name": "Flag Precision",
            "expression": "DIVIDE([True Positives], [Flagged Transactions])",
            "formatString": "0.00%",
            "lineageTag": "9d91c65d-d1d5-461d-800a-054976f2e3af"
          },
          {
            "name": "Flag Recall",
            "expression": "DIVIDE([True Positives], [Fraud Transactions])",
            "formatString": "0.0000%",
            "lineageTag": "475d818b-43a4-4cc4-9654-084cf5aaee36"
          },
          {
            "name": "Originators (snapshot)",
            "expression": "6353307",
            "formatString": "#,0",
            "lineageTag": "28af17ed-2b40-46b2-aa5d-7dd0dd1b54e0"
          },
          {
            "name": "Recipients (snapshot)",
            "expression": "2722362",
            "formatString": "#,0",
            "lineageTag": "97864252-23da-4baf-840b-965903b2576c"
          },
          {
            "name": "Profiled Accounts",
            "expression": "COUNTROWS(AccountProfiles)",
            "formatString": "#,0",
            "lineageTag": "c3eeae4f-e87b-4dd6-a223-01ae0b5ac9e2"
          },
          {
            "name": "Profiled Transactions",
            "expression": "SUM(AccountProfiles[transaction_count])",
            "formatString": "#,0",
            "lineageTag": "9a3e3921-fe81-403a-b466-82b29c1bd4ef"
          },
          {
            "name": "Report Heading",
            "expression": "\"PAYSIM | TRANSACTION & FRAUD ANALYTICS\"",
            "lineageTag": "34ee8075-aae2-4f34-9ba1-6cd3ff1b973f"
          },
          {
            "name": "Report Note",
            "expression": "\"SYNTHETIC | Simulation hours, not dates | Unspecified local currency | Fraud amount is not realized loss\"",
            "lineageTag": "e394ccc6-7661-4fe5-be8c-b678cdcd365c"
          },
          {
            "name": "Account Note",
            "expression": "\"TOP 1,000 ORIGINATORS by count, then amount, then ID | Whole snapshot; no time/type slicers\"",
            "lineageTag": "3da0fe94-d954-4a11-bc18-077073a1e1e6"
          }
        ],
