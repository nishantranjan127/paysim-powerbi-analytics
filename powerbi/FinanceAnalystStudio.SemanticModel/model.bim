            "summarizeBy": "none"
          }
        ],
        "lineageTag": "7df61ddb-bf38-4274-9b10-39e81f960017",
        "measures": [
          {
            "name": "Valid Attempts",
            "expression": "COUNTROWS(Transactions)",
            "formatString": "#,0",
            "lineageTag": "6fd18d9d-0153-4ab8-b576-bc16201f97a2"
          },
          {
            "name": "Posted Transactions",
            "expression": "CALCULATE([Valid Attempts], KEEPFILTERS(Transactions[status] = \"POSTED\"))",
            "formatString": "#,0",
            "lineageTag": "68092bd9-51dd-4404-89d2-93de69f81624"
          },
          {
            "name": "Declined Attempts",
            "expression": "CALCULATE([Valid Attempts], KEEPFILTERS(Transactions[status] = \"DECLINED\"))",
            "formatString": "#,0",
            "lineageTag": "215038eb-9294-4aa5-86ef-4910024468ca"
          },
          {
            "name": "Decline Rate",
            "expression": "DIVIDE([Declined Attempts], [Valid Attempts])",
            "formatString": "0.00%",
            "lineageTag": "f60e5b43-f1d1-420d-baec-9ad7dba176bf"
          },
          {
            "name": "Active Accounts",
            "expression": "DISTINCTCOUNT(Transactions[account_id])",
            "formatString": "#,0",
            "lineageTag": "fb26b12b-1751-484c-80a7-5b751fc57138"
          },
          {
            "name": "Posted Inflow",
            "expression": "IF(HASONEVALUE(Transactions[currency]), COALESCE(CALCULATE(SUM(Transactions[amount]), KEEPFILTERS(Transactions[status] = \"POSTED\"), KEEPFILTERS(Transactions[transaction_type] = \"CREDIT\")), 0))",
            "formatString": "#,0.00",
            "lineageTag": "029ed116-774c-43a3-ae08-c5e8a5e6f30d"
          },
          {
            "name": "Posted Outflow",
            "expression": "IF(HASONEVALUE(Transactions[currency]), COALESCE(CALCULATE(SUM(Transactions[amount]), KEEPFILTERS(Transactions[status] = \"POSTED\"), KEEPFILTERS(Transactions[transaction_type] = \"DEBIT\")), 0))",
            "formatString": "#,0.00",
            "lineageTag": "aca3ca42-1d11-47ec-8769-d1b1bdf15304"
          },
          {
            "name": "Net Cash Flow",
            "expression": "IF(HASONEVALUE(Transactions[currency]), [Posted Inflow] - [Posted Outflow])",
            "formatString": "#,0.00",
            "lineageTag": "e03bd28b-a11e-434f-a994-26cc0cab4686"
          },
          {
            "name": "Posted Gross Activity",
            "expression": "IF(HASONEVALUE(Transactions[currency]), [Posted Inflow] + [Posted Outflow])",
            "formatString": "#,0.00",
            "lineageTag": "9f32f4ee-2859-45c8-9454-49c6f0cbac10"
          },
          {
            "name": "Average Posted Amount",
            "expression": "DIVIDE([Posted Gross Activity], [Posted Transactions])",
            "formatString": "#,0.00",
            "lineageTag": "19ee7ca3-f240-4033-9f0c-9e474b0d448a"
          },
          {
            "name": "Report Heading",
            "expression": "\"FINANCE ANALYST STUDIO | \" & SELECTEDVALUE(Transactions[currency], \"SELECT ONE CURRENCY\")",
            "lineageTag": "ba9246d9-7e10-4184-8af0-590f3e9e8d0d"
          },
          {
            "name": "Report Note",
            "expression": "\"SYNTHETIC DATA | UTC dates | Posted cash flow only | No FX conversion\"",
            "lineageTag": "505babe5-70d3-44a6-a1aa-066d2b092971"
          }
        ],
        "partitions": [
          {
            "name": "Transactions",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Lines.FromBinary(File.Contents(\"C:\\Users\\v-nisranjan\\Downloads\\New folder (2)\\data\\output\\silver_transactions.jsonl\"), null, false, 65001),",
                "    Records = List.Transform(Source, each Json.Document(_)),",
                "    Rows = Table.FromRecords(Records),",
                "    Typed = Table.TransformColumnTypes(Rows, {",
                "        {\"transaction_id\", type text}, {\"account_id\", type text},",
                "        {\"event_time\", type text}, {\"amount\", Currency.Type}, {\"currency\", type text},",
                "        {\"transaction_type\", type text}, {\"merchant_country\", type text},",
                "        {\"status\", type text}, {\"transaction_date\", type date},",
                "        {\"is_high_value\", type logical}",
                "    }, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
